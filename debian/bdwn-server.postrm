#!/bin/sh
set -e

case "$1" in
    purge)
        # Only this package's config: the repositories in /backups/servers,
        # the backup users and the sshd drop-in are left untouched on purpose.
        rm -f /etc/bdwn/bdwn-export.conf
        rmdir --ignore-fail-on-non-empty /etc/bdwn 2> /dev/null || true
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument: $1" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
