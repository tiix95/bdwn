#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_build:
	@# Nothing to build - shell script installed as-is

override_dh_auto_test:
	@# No tests during packaging

override_dh_auto_install:
	install -d debian/bdwn/usr/bin
	install -m 0755 src/bdwn.sh debian/bdwn/usr/bin/bdwn
	install -d debian/bdwn/usr/share/bdwn
	install -m 0640 examples/bdwn.conf debian/bdwn/usr/share/bdwn/bdwn.conf.example
	install -m 0644 examples/ssh_config debian/bdwn/usr/share/bdwn/ssh_config.example
	install -m 0644 files/systemd/zfs-dropin.conf debian/bdwn/usr/share/bdwn/zfs-dropin.conf.example
	install -m 0644 files/systemd/local-repo-dropin.conf debian/bdwn/usr/share/bdwn/local-repo-dropin.conf.example
	install -d debian/bdwn/lib/systemd/system
	install -m 0644 files/systemd/bdwn.service debian/bdwn/lib/systemd/system/bdwn.service
	install -m 0644 files/systemd/bdwn.timer debian/bdwn/lib/systemd/system/bdwn.timer
	install -m 0644 files/systemd/bdwn-zfs-sync.service debian/bdwn/lib/systemd/system/bdwn-zfs-sync.service
	install -m 0644 files/systemd/bdwn-zfs-sync.timer debian/bdwn/lib/systemd/system/bdwn-zfs-sync.timer
	install -d debian/bdwn-server/usr/bin
	install -m 0755 server/setup-backup-user.sh debian/bdwn-server/usr/bin/bdwn-setup-backup-user
	install -m 0755 server/bdwn-export.sh debian/bdwn-server/usr/bin/bdwn-export
	install -d debian/bdwn-server/usr/share/bdwn-server
	install -m 0640 examples/bdwn-export.conf debian/bdwn-server/usr/share/bdwn-server/bdwn-export.conf.example
	install -m 0644 server/sshd_bdwn-backup.conf debian/bdwn-server/usr/share/bdwn-server/sshd_bdwn-backup.conf.example
	install -m 0644 files/systemd/webui-tcp-dropin.conf debian/bdwn-server/usr/share/bdwn-server/webui-tcp-dropin.conf.example
	install -m 0644 server/nginx-bdwn-webui.conf debian/bdwn-server/usr/share/bdwn-server/nginx-bdwn-webui.conf.example
	install -m 0640 examples/bdwn-webui.conf debian/bdwn-server/usr/share/bdwn-server/bdwn-webui.conf.example
	install -m 0755 server/bdwn-webui.sh debian/bdwn-server/usr/bin/bdwn-webui
	install -d debian/bdwn-server/usr/lib/python3/dist-packages/bdwn_webui/templates
	install -m 0644 src/bdwn_webui/*.py debian/bdwn-server/usr/lib/python3/dist-packages/bdwn_webui/
	install -m 0644 src/bdwn_webui/templates/status.html.j2 src/bdwn_webui/templates/refresh.js debian/bdwn-server/usr/lib/python3/dist-packages/bdwn_webui/templates/
	install -d debian/bdwn-server/lib/systemd/system
	install -m 0644 files/systemd/bdwn-export.service debian/bdwn-server/lib/systemd/system/bdwn-export.service
	install -m 0644 files/systemd/bdwn-export.timer debian/bdwn-server/lib/systemd/system/bdwn-export.timer
	install -m 0644 files/systemd/bdwn-webui.service debian/bdwn-server/lib/systemd/system/bdwn-webui.service
	install -d debian/bdwn-libvirt/usr/bin
	install -m 0755 src/bdwn-libvirt.sh debian/bdwn-libvirt/usr/bin/bdwn-libvirt
	install -d debian/bdwn-libvirt/lib/systemd/system
	install -m 0644 files/systemd/bdwn-libvirt@.service debian/bdwn-libvirt/lib/systemd/system/bdwn-libvirt@.service
	install -m 0644 files/systemd/bdwn-libvirt@.timer debian/bdwn-libvirt/lib/systemd/system/bdwn-libvirt@.timer

override_dh_installsystemd:
	@# Timer enabled and started via postinst
