#!/bin/sh
set -e

APP_USER="bdwn"
APP_GROUP="bdwn"
DATA_DIR="/var/lib/bdwn"

case "$1" in
    purge)
        # Remove data, config and cache
        rm -rf "${DATA_DIR}"
        # Only this package's config: /etc/bdwn is shared with bdwn-server
        rm -f /etc/bdwn/bdwn.conf
        rmdir --ignore-fail-on-non-empty /etc/bdwn 2> /dev/null || true
        rm -rf /var/cache/bdwn
        rm -rf /var/backups/bdwn

        # Remove system user and group
        if getent passwd "${APP_USER}" > /dev/null 2>&1; then
            deluser --system "${APP_USER}" || true
        fi
        if getent group "${APP_GROUP}" > /dev/null 2>&1; then
            delgroup --system "${APP_GROUP}" || true
        fi
        ;;

    remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
        ;;

    *)
        echo "postrm called with unknown argument: $1" >&2
        exit 1
        ;;
esac

#DEBHELPER#
exit 0
