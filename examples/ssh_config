# /var/lib/bdwn/.ssh/config - SSH configuration for the bdwn backup user.
# Mode 0600, owner bdwn:bdwn. Referenced by BDWN_REPO (sftp:backup-remote:...).

Host backup-server-name
    HostName backup-server-ip
    Port backup-server-port
    # SFTP user created by setup-backup-user.sh: named after this server
    User my-server-name
    IdentityFile /var/lib/bdwn/.ssh/id_ed25519
    IdentitiesOnly yes

# 'bdwn zfs-sync' only: the ZFS replication target, when it is not the server
# above. BDWN_ZFS_SYNC_HOST points at this Host entry.
# Host zfs-remote
#     HostName zfs.example.com
#     Port 22
#     User bdwn-zfs
#     IdentityFile /var/lib/bdwn/.ssh/id_ed25519_zfs
#     IdentitiesOnly yes

# Before the first backup, record the remote host key so restic can connect
# non-interactively (run as root):
#   ssh-keyscan -p 22 backup.example.com >> /var/lib/bdwn/.ssh/known_hosts
#   chown bdwn:bdwn /var/lib/bdwn/.ssh/known_hosts
#   chmod 0600 /var/lib/bdwn/.ssh/known_hosts
