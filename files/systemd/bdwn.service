[Unit]
Description=BackDown restic backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Runs as root so restic can read every path in BACKUP_PATHS. The SSH/SFTP
# connection itself is dropped to the unprivileged 'bdwn' user by /usr/bin/bdwn
# (runuser), so no root process ever talks to the network.
ExecStart=/usr/bin/bdwn backup

# Restic cache (root-owned; /var/lib/bdwn stays managed by the postinst,
# owned by bdwn, since it holds the ssh config and key used after the drop)
CacheDirectory=bdwn

# Filesystem
ProtectSystem=strict
# read-only so restic can read /home and /root while backing them up
ProtectHome=read-only
# A local repository (BDWN_REPO set to a path) needs its directory added
# via a drop-in: see /usr/share/bdwn/local-repo-dropin.conf.example
ReadWritePaths=/var/lib/bdwn /var/cache/bdwn
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid

# Privileges: root, reduced to the minimum capability set:
# - CAP_DAC_READ_SEARCH: read any file/dir listed in BACKUP_PATHS
# - CAP_SETUID/CAP_SETGID: runuser drops to the bdwn user for the SSH client
# - CAP_KILL: let restic terminate its bdwn-owned ssh child on abort
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SETUID CAP_SETGID CAP_KILL

# Syscalls
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@mount @clock @swap @reboot @obsolete @cpu-emulation @debug @raw-io

# Network (client only: nothing in the unit may listen)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SocketBindDeny=any

# Misc
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
UMask=0077
KeyringMode=private
